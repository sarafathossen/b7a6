{
  "info": {
    "_postman_id": "b7a6-ambulance-dispatch-exact-routes",
    "name": "Emergency Ambulance Dispatch System API",
    "description": "Production API Collection for Emergency Ambulance Dispatch System (B7A6 Assignment)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ambulance-dispatch-backend-azure.vercel.app/api/v1",
      "type": "string"
    },
    {
      "key": "callerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "driverToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (/auth)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarafat Caller\",\n  \"email\": \"testcaller@example.com\",\n  \"password\": \"Caller@password123\",\n  \"phone\": \"01750187656\",\n  \"role\": \"CALLER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Caller)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"caller@example.com\",\n  \"password\": \"Caller@password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Driver)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@example.com\",\n  \"password\": \"Driver@password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users (/users)",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarafat Hossen Updated\",\n  \"phone\": \"01750187656\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Change User Role (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/:id/role",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id", "role"],
              "variable": [{ "key": "id", "value": "USER_ID" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Emergency Requests (/emergency-requests)",
      "item": [
        {
          "name": "Create Emergency Request (Caller)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": \"House 12, Road 5, Dhanmondi, Dhaka\",\n  \"destinationAddress\": \"Dhaka Medical College Hospital\",\n  \"priority\": \"CRITICAL\",\n  \"totalAmount\": 2500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/emergency-requests",
              "host": ["{{baseUrl}}"],
              "path": ["emergency-requests"]
            }
          }
        },
        {
          "name": "Get All Requests (Search, Filter, Pagination)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/emergency-requests?page=1&limit=10&status=PENDING&searchTerm=Dhanmondi",
              "host": ["{{baseUrl}}"],
              "path": ["emergency-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PENDING" },
                { "key": "searchTerm", "value": "Dhanmondi" }
              ]
            }
          }
        },
        {
          "name": "Get Single Request",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/emergency-requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["emergency-requests", ":id"],
              "variable": [{ "key": "id", "value": "REQUEST_ID" }]
            }
          }
        },
        {
          "name": "Assign Driver & Ambulance (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"DRIVER_PROFILE_ID\",\n  \"ambulanceId\": \"AMBULANCE_ID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/emergency-requests/:id/assign",
              "host": ["{{baseUrl}}"],
              "path": ["emergency-requests", ":id", "assign"],
              "variable": [{ "key": "id", "value": "REQUEST_ID" }]
            }
          }
        },
        {
          "name": "Update Trip Status (Driver)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EN_ROUTE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/emergency-requests/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["emergency-requests", ":id", "status"],
              "variable": [{ "key": "id", "value": "REQUEST_ID" }]
            }
          }
        },
        {
          "name": "Cancel Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/emergency-requests/:id/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["emergency-requests", ":id", "cancel"],
              "variable": [{ "key": "id", "value": "REQUEST_ID" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Ambulances (/ambulances)",
      "item": [
        {
          "name": "Create Ambulance (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"DHAKA-METRO-EM-01\",\n  \"type\": \"ICU_AMBULANCE\",\n  \"basePrice\": 2500,\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ambulances",
              "host": ["{{baseUrl}}"],
              "path": ["ambulances"]
            }
          }
        },
        {
          "name": "Get All Ambulances (Filter & Pagination)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ambulances?page=1&limit=10&isAvailable=true",
              "host": ["{{baseUrl}}"],
              "path": ["ambulances"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "isAvailable", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Soft Delete Ambulance (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ambulances/:id",
              "host": ["{{baseUrl}}"],
              "path": ["ambulances", ":id"],
              "variable": [{ "key": "id", "value": "AMBULANCE_ID" }]
            }
          }
        }
      ]
    },
    {
      "name": "5. Drivers (/drivers)",
      "item": [
        {
          "name": "Get Driver's Assigned Trips",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/drivers/my-assigned",
              "host": ["{{baseUrl}}"],
              "path": ["drivers", "my-assigned"]
            }
          }
        },
        {
          "name": "Update Driver Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drivers/availability",
              "host": ["{{baseUrl}}"],
              "path": ["drivers", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Hospitals (/hospitals)",
      "item": [
        {
          "name": "Create Hospital (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dhaka Medical College Hospital\",\n  \"address\": \"Secretariat Road, Dhaka\",\n  \"contactNumber\": \"01711000000\",\n  \"emergencyUnits\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospitals",
              "host": ["{{baseUrl}}"],
              "path": ["hospitals"]
            }
          }
        },
        {
          "name": "Get All Hospitals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hospitals",
              "host": ["{{baseUrl}}"],
              "path": ["hospitals"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Payments (/payments)",
      "item": [
        {
          "name": "Initiate bKash Payment (Caller)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"REQUEST_ID\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "initiate"]
            }
          }
        },
        {
          "name": "bKash Callback Verification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/bkash-callback?paymentID=TR001EXAMPLE&status=success",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "bkash-callback"],
              "query": [
                { "key": "paymentID", "value": "TR001EXAMPLE" },
                { "key": "status", "value": "success" }
              ]
            }
          }
        },
        {
          "name": "Get Single Payment Record",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{callerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/:id",
              "host": ["{{baseUrl}}"],
              "path": ["payments", ":id"],
              "variable": [{ "key": "id", "value": "PAYMENT_ID" }]
            }
          }
        }
      ]
    }
  ]
}